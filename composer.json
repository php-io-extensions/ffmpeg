{
    "name": "php-io-extensions/ffmpeg",
    "type": "php-ext",
    "description": "1:1 PHP bindings of FFmpeg: libavformat, libavcodec, libavutil, libswscale and libswresample",
    "keywords": [
        "ffmpeg",
        "video",
        "audio",
        "php-ext"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Project Saturn Studios, LLC",
            "email": "info@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": ">=8.4"
    },
    "require-dev": {
        "pestphp/pest": "^4.0"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.11.x-dev"
        },
        "venusian": {
            "system": {
                "apt": {
                    "depends": [
                        "libavformat61",
                        "libavcodec61",
                        "libavutil59",
                        "libswscale8",
                        "libswresample5"
                    ]
                },
                "brew": {
                    "build": [
                        "ffmpeg"
                    ]
                }
            }
        }
    },
    "php-ext": {
        "extension-name": "ffmpeg",
        "priority": 30,
        "support-zts": true,
        "support-nts": true,
        "os-families": [
            "linux",
            "darwin"
        ],
        "configure-options": [
            {
                "name": "enable-ffmpeg",
                "description": "Enable the ffmpeg extension",
                "needs-value": false
            }
        ]
    }
}
